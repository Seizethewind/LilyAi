<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Router" android:textSize="18sp" />
        <EditText android:id="@+id/router_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Router URL (ends with /v1)" android:inputType="textUri" />
        <EditText android:id="@+id/router_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Router unified key" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Turso: Journal" android:textSize="18sp" />
        <EditText android:id="@+id/journal_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Journal DB URL (libsql://...)" android:inputType="textUri" />
        <EditText android:id="@+id/journal_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Journal DB token" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Turso: Proven facts" android:textSize="18sp" />
        <EditText android:id="@+id/facts_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Facts DB URL (libsql://...)" android:inputType="textUri" />
        <EditText android:id="@+id/facts_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Facts DB token" android:inputType="textPassword" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Turso: Knowledge (a third, separate database)" android:textSize="18sp" />
        <EditText android:id="@+id/knowledge_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Knowledge DB URL (libsql://...)" android:inputType="textUri" />
        <EditText android:id="@+id/knowledge_token" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Knowledge DB token" android:inputType="textPassword" />
        <Button
            android:id="@+id/check_knowledge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check knowledge database" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Embeddings (meaning search)" android:textSize="18sp" />
        <EditText android:id="@+id/embed_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Embeddings URL (ends with /v1), empty = keyword search only" android:inputType="textUri" />
        <EditText android:id="@+id/embed_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Embeddings key (optional)" android:inputType="textPassword" />
        <EditText android:id="@+id/embed_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Embedding model id (never auto)" android:inputType="text" />
        <EditText android:id="@+id/embed_tag" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tag (optional, defaults to the model id)" android:inputType="text" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Pandastack" android:textSize="18sp" />
        <EditText android:id="@+id/panda_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="API URL (default api.pandastack.ai)" android:inputType="textUri" />
        <EditText android:id="@+id/panda_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Pandastack API key" android:inputType="textPassword" />
        <EditText android:id="@+id/verify_commands" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Check commands, one per line (empty = detect)" android:inputType="textMultiLine" android:minLines="2" android:gravity="top" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />

    </LinearLayout>
</ScrollView>
