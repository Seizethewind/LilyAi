<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Keeps queued tasks running while the app is not on screen (shell/TaskService). POST_NOTIFICATIONS lets its notification show on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the person choose a shared workspace folder (Settings, Workspace folder) that Termux and a file manager can also see.
         Without it, or until the person allows it, the app's private workspace is used. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Used only by the optional Termux plugin (assets/plugins/termux.json). Android needs this declared at build
         time; it does nothing unless that plugin is installed, turned on and allowed. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <!-- Lets Lily see Termux (Android 11+ hides other apps). Another plugin's target app needs its own entry. -->
        <package android:name="com.termux" />
    </queries>

    <!-- requestLegacyExternalStorage: on Android 10 the shared workspace folder is written with plain file paths, which that
         version only allows with this flag. Android 11 and later ignore it and use All files access instead. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LilyAi">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".editor.EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".shell.TaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Receives the answer a plugin's target app sends back. Not exported: only Lily's own PendingIntent reaches it. -->
        <receiver
            android:name=".plugins.PluginResultReceiver"
            android:exported="false" />
    </application>

</manifest>
